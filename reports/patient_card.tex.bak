% #2 is UPPERCASED; the optional #1 tail is not -- \MakeUppercase would otherwise
% case-change a colour name inside it (\color{crit} -> \color{CRIT}, undefined).
\newcommand{\hdr}[2][]{%
  {\sffamily\bfseries\footnotesize\color{ink}\MakeUppercase{#2}}%
  {\sffamily\footnotesize\color{faint}\,#1}%
  \par\vspace{1pt}{\color{rule}\hrule height .6pt}\vspace{3pt}}

\tikzset{
  comp/.style={draw,rounded corners=2.5pt,minimum width=2.45cm,minimum height=0.82cm,
               align=center,font=\sffamily\scriptsize,line width=.7pt,inner sep=1.5pt},
  Csafe/.style={comp,fill=safe!12,draw=safe!75!black,text=ink},
  Cwarn/.style={comp,fill=warn!22,draw=warn!85!black,text=ink},
  Ccrit/.style={comp,fill=crit!20,draw=crit!85!black,text=ink,line width=1.1pt},
  Carte/.style={comp,fill=arte!12,draw=arte!75!black,text=ink,dashed},
  Cunev/.style={comp,fill=black!4,draw=unev,text=unev,dash pattern=on 2pt off 1.6pt},
  ifc/.style={draw,rounded corners=1.5pt,minimum height=0.42cm,align=center,
              font=\sffamily\tiny,line width=.5pt,inner sep=1.6pt,fill=white},
  Isafe/.style={ifc,fill=safe!10,draw=safe!70!black,text=ink},
  Iwarn/.style={ifc,fill=warn!20,draw=warn!85!black,text=ink},
  Icrit/.style={ifc,fill=crit!18,draw=crit!85!black,text=ink,line width=.9pt},
  Iarte/.style={ifc,fill=arte!10,draw=arte!70!black,text=ink,dashed},
  Iunev/.style={ifc,fill=black!3,draw=unev,text=unev,dash pattern=on 1.6pt off 1.4pt},
  fl/.style={-{Stealth[length=4pt]},line width=.75pt,color=ink!65},
  flu/.style={-{Stealth[length=4pt]},line width=.6pt,color=unev,
              dash pattern=on 2pt off 1.6pt},
  vol/.style={line width=.6pt,color=ink!40,dash pattern=on 1pt off 1.4pt},
}
\newcommand{\Q}{{\bfseries\normalsize ?}}

