\vspace{1pt}

\centering
\scalebox{1.16}{%
\begin{tikzpicture}[node distance=1cm]

% CSF / arterial chain runs straight down the LEFT; venous chain down the RIGHT.
% The internal jugular is routed OUTSIDE the venous column (x=9.6) so its label has
% room -- drawn through the middle it lands on top of the collateral box.
% ---------------- compartments
\node[Cwarn] (art)  at (0,6.1)   {Cerebral arterial\\[-1pt]{\tiny w\,0.39\ \ low}};
\node[Cunev] (cven) at (0,4.5)   {Cerebral venous\\[-1pt]{\tiny\Q}};
\node[Ccrit] (pic)  at (0,2.5)   {\textbf{Intracranial CSF}\\[-1pt]{\tiny w\,0.63\ \ low}};
\node[Ccrit] (sac)  at (0,0.4)   {\textbf{Spinal dural sac}\\[-1pt]{\tiny w\,0.63\ \ low}};
\node[Cunev] (para) at (0,-1.9)  {Paravertebral\\[-1pt]{\tiny\Q}};

\node[Csafe] (sin)  at (6.6,5.3) {Dural sinus\\[-1pt]{\tiny w\,0.11\ \ high}};
\node[Cunev] (bulb) at (6.6,3.3) {Jugular bulb\\[-1pt]{\tiny\Q}};
\node[Cunev] (plex) at (6.6,1.0) {Vertebral plexus\\[-1pt]{\tiny\Q}};
\node[Cunev] (sys)  at (6.6,-1.9){Systemic venous\\[-1pt]{\tiny\Q}};

% ---------------- flow interfaces
\draw[flu] (art)  -- node[Iunev,pos=.5] {arteriolar / capillary \ \Q} (cven);
\draw[flu] (cven) -- node[Iunev,pos=.5] {cerebral venous outflow \ \Q} (sin);
\draw[fl]  (pic.east)  -- node[Icrit,pos=.46,sloped,above=-1pt]
           {CSF absorption, cranial\ \ \textbf{w\,1.53} low} (sin.south west);
\draw[flu] (pic)  -- node[Iunev,pos=.5] {craniospinal channel \ \Q} (sac);
\draw[fl]  (sac)  -- node[Icrit,pos=.5] {CSF absorption, spinal\ \ \textbf{w\,1.53} low} (para);
\draw[flu] (sin)  -- node[Iunev,pos=.5] {sinus $\to$ bulb \ \Q} (bulb);
\draw[fl]  (bulb) -- node[Iarte,pos=.5] {vertebral collateral\ \ \textbf{ARTEFACT}} (plex);
% jugular: out to the right, clear of the column
\draw[fl]  (bulb.east) to[out=0,in=0,looseness=1.15]
           node[Iarte,pos=.5,right=1mm] {internal jugular\ \ \textbf{ARTEFACT}} (sys.east);
\draw[flu] (plex.west) to[out=180,in=0]
           node[Iunev,pos=.5,above=-1pt] {plexus drainage \ \Q} (para.north east);
\draw[flu] (plex) -- node[Iunev,pos=.5] {plexus shunt \ \Q} (sys);
\draw[flu] (para) -- node[Iunev,pos=.5] {azygos return \ \Q} (sys);
% volume coupling: arterial displaces into the CSF space, no resistance element
\draw[vol] (art.west) to[out=180,in=180,looseness=1.5]
           node[pos=.5,left=1mm,font=\tiny,color=faint,align=right]
           {volume\\coupling\\{\scriptsize(no element)}} (pic.west);

